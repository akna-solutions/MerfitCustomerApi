<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <!-- Unique index ve check constraint gibi veritabani seviyesindeki kurallari gercek bir iliskisel
         veritabaninda (in-memory SQLite) dogrulamak icin; yalnizca test projesinde kullanilir. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
    <!-- Admin uc noktalarinin yetkilendirmesini gercek ASP.NET Core pipeline'i (JWT + "AdminOnly" policy) uzerinden dogrulamak icin. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MerfitCustomerApi.Business\MerfitCustomerApi.Business.csproj" />
    <ProjectReference Include="..\MerfitCustomerApi.Api\MerfitCustomerApi.Api.csproj" />
  </ItemGroup>

</Project>
