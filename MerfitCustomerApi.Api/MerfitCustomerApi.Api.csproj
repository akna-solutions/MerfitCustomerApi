<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Yerel gizli ayarlar (orn. Resend:ApiKey) icin Visual Studio User Secrets; Git'e girmez. -->
		<UserSecretsId>f3bde431-a4e8-463b-92b1-d40766b87309</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.11" />
		<!-- Yalnizca tasarim zamani (dotnet ef migrations) icin; runtime ciktisina dahil edilmez. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MerfitCustomerApi.Business\MerfitCustomerApi.Business.csproj" />
	  <ProjectReference Include="..\MerfitCustomerApi.Infrastructure\MerfitCustomerApi.Infrastructure.csproj" />
	</ItemGroup>
</Project>
